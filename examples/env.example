# Example environment file.
#
#   cp examples/env.example .env
#
# ===== Icarus Options =====
# See https://github.com/RocketWerkz/IcarusDedicatedServer/wiki/Server-Config-&-Launch-Parameters#command-line-args
#
# Each variable maps to one launch argument: take the argument name and write
# it in UPPER_SNAKE_CASE (-SteamServerName -> STEAM_SERVER_NAME, -QueryPort ->
# QUERY_PORT). Arguments already in capitals keep their name (-PORT -> PORT,
# -LOG -> LOG, -ABSLOG -> ABSLOG, -MULTIHOME -> MULTIHOME). The one irregular
# name is -saveddirsuffix, which the game spells in lowercase: SAVED_DIR_SUFFIX.
#
# The mapping is written out by hand in scripts/entrypoint.sh, so only the
# variables listed here are passed; adding a new one does nothing.
# RESUME_PROSPECT is a switch: set it to any value to pass -ResumeProspect.
# Commented-out options are left off the command line entirely.
#
# Listed in the order the wiki documents them. MAX_PLAYERS (-MaxPlayers) is not
# in that list; the wiki documents MaxPlayers as a ServerSettings.ini setting.

STEAM_SERVER_NAME=Icarus Server
# USER_DIR=
# SAVED_DIR_SUFFIX=
# LOG=
# ABSLOG=
PORT=17777
QUERY_PORT=27015
# MULTIHOME=
# RESUME_PROSPECT=
# LOAD_PROSPECT=
# CREATE_PROSPECT=
MAX_PLAYERS=8

# ===== PASSWORDS =====
# Join and admin passwords are NOT set here. They belong in
#   game-files/Icarus/Saved/Config/WindowsServer/ServerSettings.ini
# under [/Script/Icarus.DedicatedServerSettings]. See the README.

# ===== Startup Script Options =====
# Attempt to Update the game every startup. Very efficient with DepotDownloader
UPDATE_ON_START=true
# Re-checksum every installed file when updating, and re-fetch only the chunks
# that differ. Catches corruption a plain update misses; costs a disk read.
VALIDATE_ON_UPDATE=true
# Seconds to wait for a clean shutdown before killing the server. Keep this
# below the compose `stop_grace_period` so the fallback still has room to act.
# SHUTDOWN_TIMEOUT=25
# Route the game download through a SOCKS proxy via proxychains. This covers
# every socket it opens, including the Steam connection, not just HTTP.
# Format: socks5://[user:pass@]host:port  (socks4:// also accepted; a bare
# host:port is treated as socks5).
# SOCKS_PROXY=socks5://10.0.0.2:1080
